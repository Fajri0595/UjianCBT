# ============================================================
# CBT BAHASA — Environment Variables Template
# Salin file ini menjadi .env.local untuk pengujian lokal,
# atau masukkan nilai-nilai ini di Vercel Dashboard > Project Settings > Environment Variables
# ============================================================

# URL Database PostgreSQL (Dihasilkan otomatis jika menggunakan Vercel Postgres / Neon / Supabase)
# Format: postgres://username:password@hostname:5432/dbname?sslmode=require
POSTGRES_URL="postgres://postgres:password@ep-sample-123.ap-southeast-1.neon.tech/neondb?sslmode=require"

# Kunci Rahasia untuk Enkripsi Token Sesi HMAC (Karakter Acak Bebas)
CBT_API_SECRET="cbt_super_secret_key_random_64_characters_long_2026"

# Garam Enkripsi Hash Password
SALT_KEY="cbt_password_salt_kebahasaan_2026"

# (Opsional) Token Penyimpanan File Audio Vercel Blob
# Dihasilkan otomatis jika Anda mengaktifkan Vercel Blob di tab Storage
BLOB_READ_WRITE_TOKEN=""

